# ==============================================================================
# AgroSmart AI — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB)
# Provide your MongoDB Atlas connection string or local MongoDB URI.
# If left empty in development, AgroSmart AI will automatically fall back to an in-memory MongoDB instance!
MONGODB_URI=mongodb://localhost:27017/agrosmart_ai

# Security & Authentication
JWT_ACCESS_SECRET=agrosmart_super_secure_jwt_access_secret_key_minimum_32_characters_long_12345
JWT_REFRESH_SECRET=agrosmart_super_secure_jwt_refresh_secret_key_minimum_32_characters_long_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=agrosmart_cookie_signing_secret_key_32_chars_long

# AI / Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000

# Weather API Configuration
# AgroSmart AI uses the free Open-Meteo API by default (no API key required).
# Optionally set OPENWEATHER_API_KEY if you want to use the OpenWeatherMap provider.
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=

# Mandi Market Price API Configuration
# Supported providers: agmarknet, data.gov.in, or fallback_curated
MANDI_API_PROVIDER=fallback_curated
DATA_GOV_IN_API_KEY=

# LLM Agricultural Assistant Provider Configuration
# Supported: gemini, openai, groq, mock_fallback
LLM_PROVIDER=mock_fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_TITLE=AgroSmart AI
VITE_ENABLE_DEMO_MODE=true
